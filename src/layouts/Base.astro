---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '../styles/global.css';
import { allLocales, available, t, type Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = t(lang);
const dir = allLocales[lang].dir;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.meta.title}</title>
    <meta name="description" content={d.meta.description} />
    <meta property="og:title" content={d.meta.title} />
    <meta property="og:description" content={d.meta.description} />
    <meta name="theme-color" content="#221c18" />
    {available.map((l) => <link rel="alternate" hreflang={l} href={`/${l}/`} />)}
  </head>
  <body>
    <header class="site-header" id="top">
      <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu">
        <svg viewBox="0 0 28 12" width="28" height="12" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M0 1h28M0 11h18"/></svg>
        <span class="menu-label">{d.nav.menu}</span>
      </button>
      <a class="brand" href={`/${lang}/`} aria-label="Aurora Hacienda Zanzibar">
        <span class="brand-main">Aurora</span>
        <span class="brand-sub">Hacienda Zanzibar</span>
      </a>
      <a href="#book" class="head-book">{d.nav.book}</a>
    </header>

    <div class="menu" id="menu" hidden>
      <button class="menu-close" id="menu-close" aria-label={d.nav.close}>
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </button>
      <nav class="menu-links" aria-label="Main">
        <a href="#welcome">{d.nav.home}</a>
        <a href="#rooms">{d.nav.stay}</a>
        <a href="#house">{d.nav.house}</a>
        <a href="#nungwi">{d.nav.place}</a>
        <a href="#book">{d.nav.book}</a>
      </nav>
      {available.length > 1 && (
        <div class="lang" aria-label={d.nav.language}>
          {available.map((l) => (
            <a href={`/${l}/`} lang={l} aria-current={l === lang ? 'true' : undefined}>{allLocales[l].label}</a>
          ))}
        </div>
      )}
    </div>

    <nav class="dots" id="dots" aria-hidden="true"></nav>

    <slot />

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-brand">Aurora Hacienda Zanzibar</p>
        <p>{d.footer.address}</p>
        <p class="legal">© {year} Aurora Hacienda Zanzibar. {d.footer.rights}</p>
        <p class="credit">{d.footer.credit}</p>
        <p class="photo-credit">{d.footer.photoCredit}</p>
      </div>
    </footer>

    <script is:inline>
      const $ = (id) => document.getElementById(id);
      const menu = $('menu'), mb = $('menu-btn');
      const setMenu = (o) => { menu.hidden = !o; mb.setAttribute('aria-expanded', o); document.body.classList.toggle('lock', o); };
      mb.addEventListener('click', () => setMenu(true));
      $('menu-close').addEventListener('click', () => setMenu(false));
      menu.addEventListener('click', (e) => { if (e.target.closest('.menu-links a')) setMenu(false); });
      addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });

      const h = document.querySelector('.site-header');
      const f = () => h.classList.toggle('solid', scrollY > 40);
      addEventListener('scroll', f, { passive: true }); f();

      // side dots
      const dots = $('dots'), secs = [...document.querySelectorAll('[data-dot]')];
      secs.forEach((s, i) => {
        const a = document.createElement('a');
        a.href = '#' + (s.id || ''); a.title = s.dataset.dot; a.dataset.i = i;
        if (s.id) dots.appendChild(a);
      });
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) {
          const i = secs.indexOf(e.target);
          dots.querySelectorAll('a').forEach((a) => a.classList.toggle('on', +a.dataset.i === i));
        }
      }), { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
      secs.forEach((s) => io.observe(s));

      // reveal
      const ro = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); } }), { threshold: 0.2 });
      document.querySelectorAll('.reveal').forEach((el) => ro.observe(el));
    </script>
  </body>
</html>
