---
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '../styles/global.css';
import { allLocales, available, t, type Locale } from '../i18n';
import { contact, coordsDisplay, mapUrl } from '../i18n/site';

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = t(lang);
const dir = allLocales[lang].dir;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{d.meta.title}</title>
    <meta name="description" content={d.meta.description} />
    <meta property="og:title" content={d.meta.title} />
    <meta property="og:description" content={d.meta.description} />
    <meta name="theme-color" content="#0e0b09" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/images/logo-seal.png" />
    <link rel="apple-touch-icon" href="/images/logo-seal.png" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {available.map((l) => <link rel="alternate" hreflang={l} href={`/${l}/`} />)}
  </head>
  <body>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <header class="site-header" id="top">
      <div class="header-left">
        <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu">
          <svg class="menu-icon" viewBox="0 0 28 12" width="28" height="12" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M0 1h28M0 11h18"/>
          </svg>
          <span class="menu-label">{d.nav.menu}</span>
        </button>
        <nav class="head-nav" aria-label={d.nav.quick}>
          <a href="#rooms">{d.nav.stay}</a>
          <a href="#dining">{d.nav.dining}</a>
          <a href="#experiences">{d.nav.experiences}</a>
        </nav>
      </div>

      <a class="brand" href={`/${lang}/`} aria-label="Aurora Hacienda Zanzibar">
        <img src="/images/logo-seal.png" alt="" class="brand-seal" width="44" height="44" />
        <span class="brand-text">
          <span class="brand-main">Aurora</span>
          <span class="brand-sub">Hacienda Zanzibar</span>
        </span>
      </a>

      <div class="header-right">
        <nav class="head-nav" aria-label={d.nav.place}>
          <a href="#house">{d.nav.house}</a>
          <a href="#nungwi">{d.nav.place}</a>
        </nav>
        <a href="#book" class="head-book"><span>{d.nav.book}</span></a>
      </div>
    </header>

    <div class="menu" id="menu" data-lenis-prevent aria-hidden="true" inert>
      <button class="menu-close" id="menu-close" aria-label={d.nav.close}>
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
        <span class="menu-label">{d.nav.close}</span>
      </button>

      <div class="menu-grid">
        <div class="menu-nav-col">
          <div class="menu-brand-head">
            <img src="/images/logo-seal.png" alt="" class="menu-seal" width="52" height="52" />
            <p class="eyebrow menu-eyebrow">Aurora Hacienda Zanzibar</p>
          </div>
          <nav class="menu-links" aria-label="Main">
            <a href="#welcome" data-preview="/images/welcome.jpg"><span class="menu-num">01</span><span>{d.nav.home}</span></a>
            <a href="#rooms" data-preview="/images/room-1.jpg"><span class="menu-num">02</span><span>{d.nav.stay}</span></a>
            <a href="#dining" data-preview="/images/dining.jpg"><span class="menu-num">03</span><span>{d.nav.dining}</span></a>
            <a href="#house" data-preview="/images/house.jpg"><span class="menu-num">04</span><span>{d.nav.house}</span></a>
            <a href="#nungwi" data-preview="/images/nungwi.jpg"><span class="menu-num">05</span><span>{d.nav.place}</span></a>
            <a href="#experiences" data-preview="/images/excursions.jpg"><span class="menu-num">06</span><span>{d.nav.experiences}</span></a>
            <a href="#book" data-preview="/images/book.jpg"><span class="menu-num">07</span><span>{d.nav.book}</span></a>
          </nav>
          {available.length > 1 && (
            <div class="lang" aria-label={d.nav.language}>
              {available.map((l) => (
                <a href={`/${l}/`} lang={l} aria-current={l === lang ? 'true' : undefined}>{allLocales[l].label}</a>
              ))}
            </div>
          )}
          <div class="menu-mobile-foot">
            <p class="menu-mobile-loc">{d.footer.address} · <span>{coordsDisplay}</span></p>
            <div class="menu-mobile-links">
              <a href={contact.whatsappUrl} target="_blank" rel="noopener">WhatsApp {contact.phoneDisplay}</a>
              <a href={contact.emailHref}>{contact.email}</a>
            </div>
            <a href="#book" class="btn btn--gold menu-mobile-cta"><span>{d.hero.cta}</span></a>
          </div>
        </div>

        <aside class="menu-showcase" aria-hidden="true">
          <div class="menu-frame">
            <img id="menu-preview" src="/images/hero.jpg" alt="" />
          </div>
          <div class="menu-caption">
            <span>{d.footer.address}</span>
            <span class="menu-coords">{coordsDisplay}</span>
          </div>
        </aside>
      </div>
    </div>

    <nav class="dots" id="dots" aria-label="Sections"></nav>

    <slot />

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-seal-wrap">
          <img src="/images/logo-seal.png" alt="Aurora Hacienda Zanzibar" class="footer-seal" width="104" height="104" />
        </div>
        <p class="footer-brand">Aurora Hacienda Zanzibar</p>
        <p class="footer-address">
          {d.footer.address}
          <span class="footer-sep" aria-hidden="true">·</span>
          <a href={mapUrl} target="_blank" rel="noopener">{coordsDisplay}</a>
        </p>
        <div class="footer-contact">
          <a href={contact.whatsappUrl} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.5 7.5L3 20.5l1.6-5.2A8.5 8.5 0 1 1 21 11.5z"/><path d="M9.5 8.8c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .5-.1.6l-.5.6c-.1.1-.1.3 0 .5a7.2 7.2 0 0 0 2.5 2.5c.2.1.4.1.5 0l.6-.5c.2-.2.4-.2.7-.1l1.6.8c.3.1.4.3.4.5v.5c0 .3-.2.7-.6.9-.6.3-1.4.4-2.5 0a9.5 9.5 0 0 1-5-5c-.4-1.1-.3-1.9 0-2.5z"/></svg>
            <span>WhatsApp {contact.phoneDisplay}</span>
          </a>
          <a href={contact.phoneHref}>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
            <span>{contact.phoneDisplay}</span>
          </a>
          <a href={contact.emailHref}>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 7l9 6 9-6"/></svg>
            <span>{contact.email}</span>
          </a>
        </div>
        <nav class="footer-links" aria-label={d.nav.quick}>
          <a href="#welcome">{d.nav.home}</a>
          <a href="#rooms">{d.nav.stay}</a>
          <a href="#dining">{d.nav.dining}</a>
          <a href="#house">{d.nav.house}</a>
          <a href="#nungwi">{d.nav.place}</a>
          <a href="#experiences">{d.nav.experiences}</a>
          <a href="#book">{d.nav.book}</a>
        </nav>
        <p class="legal">© {year} Aurora Hacienda Zanzibar. {d.footer.rights}</p>
        <p class="credit"><a href="mailto:avar.szilveszter@gmail.com">{d.footer.credit}</a></p>
      </div>
    </footer>

    <script>
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
