---
import images from '../generated/images.json';

interface Props {
  name: string;
  alt: string;
  class?: string;
  eager?: boolean;
}
const { name, alt, class: className, eager = false } = Astro.props;
const info = (images as Record<string, { width: number; height: number; widths: number[] }>)[name];
if (!info) throw new Error(`Unknown photo: ${name}`);
const url = (w: number) => `/images/opt/${name}-${w}.webp`;
---
<img
  src={url(info.widths[Math.min(1, info.widths.length - 1)])}
  srcset={info.widths.map((w) => `${url(w)} ${w}w`).join(', ')}
  sizes="(max-width: 860px) 200vh, 100vw"
  width={info.width}
  height={info.height}
  alt={alt}
  class={className}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
