---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/jost/400.css';
import { allLocales, available, t } from '../i18n';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 · Aurora Hacienda Zanzibar</title>
    <link rel="icon" type="image/png" href="/icon-192.png" />
  </head>
  <body>
    {available.map((l) => {
      const d = t(l);
      return (
        <main data-lang={l} lang={l} dir={allLocales[l].dir} hidden={l !== 'en'}>
          <img src="/images/opt/logo-192.png" alt="Aurora Hacienda Zanzibar" width="96" height="96" />
          <h1>{d.notFound.title}</h1>
          <p>{d.notFound.text}</p>
          <a href={`/${l}/`}>{d.notFound.home}</a>
          <footer>
            <p>© {year} Aurora Hacienda Zanzibar. {d.footer.rights}</p>
            <p>{d.footer.credit}</p>
          </footer>
        </main>
      );
    })}
    <script is:inline define:vars={{ available }}>
      // show exactly one language: the one in the address, then the saved or browser language
      let saved = null;
      try { saved = localStorage.getItem('lang'); } catch {}
      const wanted = [location.pathname.split('/')[1], saved, ...(navigator.languages || [])];
      const lang = wanted.map((v) => String(v || '').slice(0, 2).toLowerCase()).find((v) => available.includes(v)) || 'en';
      document.querySelectorAll('main[data-lang]').forEach((m) => (m.hidden = m.dataset.lang !== lang));
      document.documentElement.lang = lang;
    </script>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0e0b09; color: #faf6ef; font-family: 'Jost', system-ui, sans-serif; text-align: center; padding: 24px; box-sizing: border-box; }
      main[hidden] { display: none; }
      img { margin: 0 auto; display: block; }
      h1 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400; font-size: clamp(2.2rem, 7vw, 4rem); margin: .6em 0 .3em; }
      a { display: inline-block; margin-top: 1em; padding: 14px 32px; border: 1px solid #d4b075; color: #ead0a0; text-decoration: none; }
      footer { margin-top: 4em; font-size: .82rem; opacity: .6; }
    </style>
  </body>
</html>
