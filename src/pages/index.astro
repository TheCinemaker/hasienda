---
import { allLocales, available, t } from '../i18n';
import { seo } from '../i18n/site';
const abs = (path: string) => new URL(path, Astro.site).href;
const d = t('en');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={seo.indexable ? 'index, follow' : 'noindex, nofollow'} />
    <title>{d.meta.title}</title>
    <meta name="description" content={d.meta.description} />
    <link rel="canonical" href={abs('/en/')} />
    {available.map((l) => <link rel="alternate" hreflang={l} href={abs(`/${l}/`)} />)}
    <link rel="alternate" hreflang="x-default" href={abs('/en/')} />
    <link rel="icon" type="image/png" href="/icon-192.png" />
    <script is:inline define:vars={{ available }}>
      // saved choice first, then the browser's languages, then English
      let saved = null;
      try { saved = localStorage.getItem('lang'); } catch {}
      const wanted = [saved, ...(navigator.languages || [navigator.language])];
      const match = wanted.map((v) => String(v || '').slice(0, 2).toLowerCase()).find((v) => available.includes(v));
      location.replace('/' + (match || 'en') + '/' + location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/en/" /></noscript>
  </head>
  <body>
    <p>{available.map((l) => <a href={`/${l}/`} lang={l}>{allLocales[l].label} </a>)}</p>
    <footer><p>© {new Date().getFullYear()} Aurora Hacienda Zanzibar. {d.footer.rights}</p><p>{d.footer.credit}</p></footer>
  </body>
</html>
