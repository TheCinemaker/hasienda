---
import Base from '../../layouts/Base.astro';
import { available, t, type Locale } from '../../i18n';
import { contact, coordsDisplay, mapUrl, partners } from '../../i18n/site';

export function getStaticPaths() {
  return available.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const d = t(lang);

// buttons under each section of the travel information, by section index
const sectionLinks: Record<number, (readonly [keyof typeof d.info.links, string])[]> = {
  0: [['visa', 'https://visa.immigration.go.tz/']],
  1: [['insurance', 'https://inbound.visitzanzibar.go.tz/'], ['travelInsurance', partners.travelInsurance]],
  2: [['flights', partners.flights], ['esim', partners.esim]],
};
// official pages behind the travel information (checked 2026-11-27)
const sources = [
  ['entry', 'https://www.gov.uk/foreign-travel-advice/tanzania/entry-requirements'],
  ['health', 'https://wwwnc.cdc.gov/travel/destinations/traveler/none/tanzania'],
] as const;
const infoIcons = [
  'M6 3h12v18H6zM12 8.5a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM9 17.5h6',
  'M12 3l7 3v5c0 4.8-3 8.8-7 10-4-1.2-7-5.2-7-10V6l7-3zM9.5 12.2l1.8 1.8 3.5-3.6',
  'M21 15.5l-8-4.5V5a1.5 1.5 0 0 0-3 0v6l-8 4.5V18l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-3.5l8 2.5z',
  'M9.5 4h5v5.5H20v5h-5.5V20h-5v-5.5H4v-5h5.5z',
  'M3 7h18v10H3zM12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM6 10v.01M18 14v.01',
  'M9 4l-5 3 2 4 2-1v10h8V10l2 1 2-4-5-3c-.5 1.5-1.6 2-3 2s-2.5-.5-3-2z',
  'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 11v5M12 8v.01',
];

const amenityIcons = [
  'M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-3zM6 12V6a2 2 0 0 1 4 0v1',
  'M3 7h18v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7zM7 18c0-1.5 1-2 1-2M12 18c0-1.5 1-2 1-2M17 18c0-1.5 1-2 1-2',
  'M12 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0M12 10V4a3 3 0 0 1 5 2M14 12h6a3 3 0 0 1-2 5M10 12H4a3 3 0 0 1 2-5M12 14v6a3 3 0 0 1-5-2',
  'M3 6h18v11H3zM8 20h8M12 17v3',
  'M6 3h12v18H6zM6 10h12M9 6.5v1.5M9 13v3',
  'M5 9h11v6a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V9zM16 10h2a2 2 0 0 1 0 4h-2M8 5c0-1 .8-1.5.8-2.5M12 5c0-1 .8-1.5.8-2.5',
  'M4 5h16v14H4zM12 12m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0M8 19v2M16 19v2',
  'M2.5 9a14 14 0 0 1 19 0M5.5 12.5a9.5 9.5 0 0 1 13 0M8.8 16a5 5 0 0 1 6.4 0M12 19.5v.01',
];
---
<Base lang={lang}>
  <main>
    <section class="panel hero" id="top-panel" data-dot={d.nav.start}>
      <div class="panel-media">
        <img src="/images/hero.jpg" alt="" class="panel-img zoom" fetchpriority="high" />
      </div>
      <div class="shade"></div>
      <div class="panel-text reveal">
        <span class="hero-hairline" aria-hidden="true"></span>
        <p class="eyebrow">{d.hero.eyebrow}</p>
        <h1>{d.hero.title}</h1>
        <p class="lead">{d.hero.text}</p>
      </div>
      <div class="dock">
        <nav class="quick" aria-label={d.nav.quick}>
          <a href="#rooms"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18V7M3 14h18v4M21 14v-2.5A2.5 2.5 0 0 0 18.5 9H11v5M6.5 11.5a1.5 1.5 0 1 0 0-.01"/></svg>{d.nav.stay}</a>
          <a href="#dining"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 10h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5v-5zM16 11h2.5a2 2 0 0 1 0 4H16M8 6c0-1 .8-1.5.8-2.5M12 6c0-1 .8-1.5.8-2.5"/></svg>{d.nav.dining}</a>
          <a href="#house"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V10.5L12 4l8 6.5V21M4 21h16M9.5 21v-5.5a2.5 2.5 0 0 1 5 0V21"/></svg>{d.nav.house}</a>
          <a href="#nungwi"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>{d.nav.place}</a>
          <a href="#experiences"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polygon points="15.5 8.5 13.5 13.5 8.5 15.5 10.5 10.5 15.5 8.5"/></svg>{d.nav.experiences}</a>
          <a href="#info"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8v.01"/></svg>{d.nav.info}</a>
          <a href="#book"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="1"/><path d="M4 10h16M8 3v4M16 3v4"/></svg>{d.nav.book}</a>
        </nav>
        <form class="bar" id="bar" novalidate>
          <label>{d.book.arrival}<input type="date" name="arrival" placeholder={d.book.datePlaceholder} /></label>
          <label>{d.book.departure}<input type="date" name="departure" placeholder={d.book.datePlaceholder} /></label>
          <label>{d.book.guests}<input type="number" name="guests" min="1" max="12" value="2" /></label>
          <button type="submit"><span>{d.hero.check}</span></button>
        </form>
        <div class="hero-meta">
          <p class="clock"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{d.hero.time} <time id="clock"></time></p>
          <span class="meta-sep" aria-hidden="true">·</span>
          <p class="hero-coords"><bdi dir="ltr">{coordsDisplay}</bdi></p>
        </div>
        <a href="#welcome" class="scroll-cue" aria-label={d.nav.scroll}><span></span></a>
      </div>
    </section>

    <section class="panel panel-editorial" id="welcome" data-dot={d.welcome.eyebrow}>
      <div class="panel-media">
        <img src="/images/welcome.jpg" alt="" class="panel-img" loading="lazy" />
      </div>
      <div class="shade"></div>
      <div class="panel-text reveal">
        <span class="chapter-num" aria-hidden="true">01</span>
        <p class="eyebrow">{d.welcome.eyebrow}</p>
        <h2>{d.welcome.title}</h2>
        <p>{d.welcome.p1}</p>
        <p>{d.welcome.p2}</p>
        <ul class="facts-strip">
          {d.welcome.facts.map((fact) => <li>{fact}</li>)}
        </ul>
      </div>
    </section>

    <div id="rooms" data-dot={d.rooms.eyebrow}>
      {d.rooms.items.map((r, i) => (
        <section class="panel panel-suite" id={`room-${i + 1}`}>
          <div class="panel-media">
            <img src={`/images/room-${i + 1}.jpg`} alt="" class="panel-img" loading="lazy" />
          </div>
          <div class="shade"></div>
          <div class="panel-text panel-text--suite reveal">
            <div class="suite-main">
              <div class="suite-meta">
                <span class="chapter-num">02 · 0{i + 1} / 0{d.rooms.items.length}</span>
                <p class="eyebrow">{d.rooms.eyebrow}</p>
              </div>
              <h2>{r.name}</h2>
              <p class="suite-desc">{d.rooms.intro}</p>
              <ul class="amenity-strip" aria-label={d.rooms.amenitiesLabel}>
                {d.rooms.amenities.map((item, idx) => (
                  <li>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d={amenityIcons[idx] || amenityIcons[0]} />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <div class="suite-foot">
                <p class="price">
                  <span>{d.rooms.rateLabel}</span>
                  <strong>{d.rooms.rateBasis}</strong>
                  <small>{d.rooms.rateInquiry}</small>
                </p>
                <a class="btn" href="#book"><span>{d.rooms.request}</span></a>
              </div>
            </div>
            <nav class="suite-nav" aria-label={d.rooms.title}>
              {d.rooms.items.map((item, j) => (
                <a href={`#room-${j + 1}`} aria-current={i === j ? 'true' : undefined} title={item.name}>
                  0{j + 1}
                </a>
              ))}
            </nav>
          </div>
        </section>
      ))}
    </div>

    <section class="panel panel-suite panel-dining" id="dining" data-dot={d.dining.eyebrow}>
      <div class="panel-media">
        <img src="/images/dining.jpg" alt="" class="panel-img" loading="lazy" />
      </div>
      <div class="shade"></div>
      <div class="panel-text panel-text--suite reveal">
        <div class="suite-main">
          <div class="suite-meta">
            <span class="chapter-num">03</span>
            <p class="eyebrow">{d.dining.eyebrow}</p>
          </div>
          <h2>{d.dining.title}</h2>
          <p class="suite-desc">{d.dining.text}</p>
          <div class="exp-pillars exp-pillars--3">
            {d.dining.pillars.map((pillar) => (
              <div class="exp-pillar">
                <h3>{pillar.title}</h3>
                <p>{pillar.text}</p>
              </div>
            ))}
          </div>
          <div class="dining-actions">
            <button type="button" class="btn btn--gold" data-open-menu="breakfast"><span>{d.dining.breakfastBtn}</span></button>
            <button type="button" class="btn" data-open-menu="drinks"><span>{d.dining.drinkBtn}</span></button>
          </div>
        </div>
      </div>
    </section>

    <section class="panel panel-editorial" id="house" data-dot={d.house.eyebrow}>
      <div class="panel-media">
        <img src="/images/house.jpg" alt="" class="panel-img" loading="lazy" />
      </div>
      <div class="shade"></div>
      <div class="panel-text reveal">
        <span class="chapter-num" aria-hidden="true">04</span>
        <p class="eyebrow">{d.house.eyebrow}</p>
        <h2>{d.house.title}</h2>
        <p>{d.house.text}</p>
        <div class="security-strip">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M13 2.5L5 13.5h5.5l-1 8 8-11H12z"/>
          </svg>
          <div>
            <span>{d.house.powerLabel}</span>
            <p>{d.house.powerText}</p>
          </div>
        </div>
        <div class="security-strip">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3l7 3v5c0 4.8-3 8.8-7 10-4-1.2-7-5.2-7-10V6l7-3z"/>
            <path d="M9.5 12.2l1.8 1.8 3.5-3.6"/>
          </svg>
          <div>
            <span>{d.house.securityLabel}</span>
            <p>{d.house.securityText}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="panel panel-editorial" id="nungwi" data-dot={d.place.eyebrow}>
      <div class="panel-media">
        <img src="/images/nungwi.jpg" alt="" class="panel-img" loading="lazy" />
      </div>
      <div class="shade"></div>
      <div class="panel-text reveal">
        <span class="chapter-num" aria-hidden="true">05</span>
        <p class="eyebrow">{d.place.eyebrow}</p>
        <h2>{d.place.title}</h2>
        <p>{d.place.text}</p>
        <p class="coords-line"><bdi dir="ltr">{coordsDisplay}</bdi></p>
        <a class="btn" href={mapUrl} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
          <span>{d.place.map}</span>
        </a>
        <a class="btn" href="#info">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8v.01"/></svg>
          <span>{d.info.title}</span>
        </a>
      </div>
    </section>

    <div id="experiences" data-dot={d.experiences.eyebrow}>
      <section class="panel panel-suite panel-experience" id="transfer">
        <div class="panel-media">
          <img src="/images/transfer.jpg" alt="" class="panel-img" loading="lazy" />
        </div>
        <div class="shade"></div>
        <div class="panel-text panel-text--suite reveal">
          <div class="suite-main">
            <div class="suite-meta">
              <span class="chapter-num">06 · 01 / 02</span>
              <p class="eyebrow">{d.experiences.eyebrow} · {d.experiences.transfer.label}</p>
            </div>
            <h2>{d.experiences.transfer.title}</h2>
            <p class="suite-desc">{d.experiences.transfer.text}</p>
            <a class="btn" href="#book" data-request-transfer><span>{d.experiences.transfer.cta}</span></a>
          </div>
          <nav class="suite-nav" aria-label={d.experiences.eyebrow}>
            <a href="#transfer" aria-current="true" title={d.experiences.transfer.title}>01</a>
            <a href="#excursions" title={d.experiences.excursions.title}>02</a>
          </nav>
        </div>
      </section>

      <section class="panel panel-suite panel-experience" id="excursions">
        <div class="panel-media">
          <img src="/images/excursions.jpg" alt="" class="panel-img" loading="lazy" />
        </div>
        <div class="shade"></div>
        <div class="panel-text panel-text--suite reveal">
          <div class="suite-main">
            <div class="suite-meta">
              <span class="chapter-num">06 · 02 / 02</span>
              <p class="eyebrow">{d.experiences.eyebrow} · {d.experiences.excursions.label}</p>
            </div>
            <h2>{d.experiences.excursions.title}</h2>
            <p class="suite-desc">{d.experiences.excursions.text}</p>
            <div class="exp-pillars exp-pillars--3">
              {d.experiences.excursions.pillars.map((pillar) => (
                <div class="exp-pillar">
                  <h3>{pillar.title}</h3>
                  <p>{pillar.text}</p>
                </div>
              ))}
            </div>
            <a class="btn" href="#book"><span>{d.experiences.excursions.cta}</span></a>
          </div>
          <nav class="suite-nav" aria-label={d.experiences.eyebrow}>
            <a href="#transfer" title={d.experiences.transfer.title}>01</a>
            <a href="#excursions" aria-current="true" title={d.experiences.excursions.title}>02</a>
          </nav>
        </div>
      </section>
    </div>

    <section class="panel panel-editorial panel-cta" id="reserve" data-dot={d.book.eyebrow}>
      <div class="panel-media">
        <img src="/images/book.jpg" alt="" class="panel-img" loading="lazy" />
      </div>
      <div class="shade"></div>
      <div class="panel-text reveal">
        <span class="chapter-num" aria-hidden="true">07</span>
        <p class="eyebrow">{d.book.eyebrow}</p>
        <h2>{d.book.title}</h2>
        <p>{d.book.rateNote}</p>
        <a class="btn btn--gold" href="#book"><span>{d.hero.cta}</span></a>
      </div>
    </section>
  </main>

  <div class="sheet-modal" id="dining-modal" data-lenis-prevent role="dialog" aria-modal="true" aria-labelledby="dining-modal-title" aria-hidden="true" inert>
    <div class="sheet-backdrop" data-close-modal></div>
    <div class="sheet-card">
      <div class="sheet-head">
        <div class="sheet-brand">
          <img src="/images/logo-seal.png" alt="" width="38" height="38" />
          <div>
            <p class="sheet-eyebrow">Aurora Hacienda Zanzibar · Nungwi</p>
            <h2 id="dining-modal-title">{d.dining.eyebrow}</h2>
          </div>
        </div>
        <button type="button" class="sheet-close" id="dining-modal-close" aria-label={d.dining.closeMenu}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
        </button>
      </div>

      <div class="sheet-tabs" role="tablist" aria-label={d.dining.eyebrow}>
        <button type="button" role="tab" aria-selected="true" aria-controls="tab-breakfast" data-tab="breakfast">{d.dining.menus.breakfast.title}</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="tab-drinks" data-tab="drinks">{d.dining.menus.drinks.title}</button>
      </div>

      <div class="sheet-body" id="dining-modal-body" data-lenis-prevent>
        <div class="sheet-panel" id="tab-breakfast" role="tabpanel">
          <p class="sheet-sub">{d.dining.menus.breakfast.subtitle}</p>
          <a class="menu-card" href="/images/menu/breakfast.jpg" target="_blank" rel="noopener">
            <img src="/images/menu/breakfast.jpg" alt={d.dining.menus.breakfast.title} width="765" height="1024" loading="lazy" />
            <span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7"/></svg>
              {d.dining.cardOpen}
            </span>
          </a>

          <h3 class="menu-sec-title">{d.dining.menus.breakfast.fixedTitle}</h3>
          <div class="menu-list">
            {d.dining.menus.breakfast.fixed.map((item) => (
              <div class="menu-item">
                <div class="menu-item-name">{item.name}</div>
                {item.desc && <p class="menu-item-desc">{item.desc}</p>}
              </div>
            ))}
          </div>

          <h3 class="menu-sec-title">{d.dining.menus.breakfast.choiceTitle} <span>{d.dining.menus.breakfast.choiceNote}</span></h3>
          <div class="menu-cols">
            {d.dining.menus.breakfast.choices.map((group) => (
              <div class="menu-group">
                <h4>{group.title}</h4>
                <ul>
                  {group.items.map((line) => <li>{line}</li>)}
                </ul>
              </div>
            ))}
          </div>

          <div class="menu-highlight">
            <h3 class="menu-sec-title">{d.dining.menus.breakfast.zanzibariTitle} <span>{d.dining.menus.breakfast.zanzibariNote}</span></h3>
            <div class="menu-cols">
              {d.dining.menus.breakfast.zanzibari.map((item) => (
                <div class="menu-item">
                  <div class="menu-item-name">{item.name}</div>
                  <p class="menu-item-desc">{item.desc}</p>
                </div>
              ))}
            </div>
          </div>

          <p class="sheet-foot-note">{d.dining.menus.breakfast.footerNote}</p>
        </div>

        <div class="sheet-panel" id="tab-drinks" role="tabpanel" hidden>
          <p class="sheet-sub">{d.dining.menus.drinks.subtitle}</p>
          <a class="menu-card" href="/images/menu/drinks.jpg" target="_blank" rel="noopener">
            <img src="/images/menu/drinks.jpg" alt={d.dining.menus.drinks.title} width="765" height="1024" loading="lazy" />
            <span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7"/></svg>
              {d.dining.cardOpen}
            </span>
          </a>

          <div class="menu-cols">
            <div>
              <h3 class="menu-sec-title">{d.dining.menus.drinks.hotTitle}</h3>
              <div class="menu-price-list">
                {d.dining.menus.drinks.hot.map((item) => (
                  <div class="menu-row">
                    <span>{item.name}</span>
                    <span class="menu-leader" aria-hidden="true"></span>
                    <strong class="menu-price">{item.price}</strong>
                  </div>
                ))}
              </div>
            </div>
            <div>
              <h3 class="menu-sec-title">{d.dining.menus.drinks.coldTitle}</h3>
              <div class="menu-price-list">
                {d.dining.menus.drinks.cold.map((item) => (
                  <div class="menu-row">
                    <span>{item.name}</span>
                    <span class="menu-leader" aria-hidden="true"></span>
                    <strong class="menu-price">{item.price}</strong>
                  </div>
                ))}
              </div>

              <h3 class="menu-sec-title menu-sec-gap">{d.dining.menus.drinks.juiceTitle}</h3>
              <div class="menu-price-list">
                {d.dining.menus.drinks.juice.map((item) => (
                  <div class="menu-price-block">
                    <div class="menu-row">
                      <span>{item.name}</span>
                      <span class="menu-leader" aria-hidden="true"></span>
                      <strong class="menu-price">{item.price}</strong>
                    </div>
                    {item.desc && <p class="menu-item-desc">{item.desc}</p>}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <h3 class="menu-sec-title menu-sec-gap">{d.dining.menus.drinks.cocktailsTitle} <span>{d.dining.menus.drinks.cocktailsNote}</span></h3>
          <div class="menu-cols">
            <div>
              <h4 class="menu-subcat">{d.dining.menus.drinks.localCocktailsTitle}</h4>
              <div class="menu-list">
                {d.dining.menus.drinks.localCocktails.map((c) => (
                  <div class="menu-item">
                    <div class="menu-item-name">{c.name}</div>
                    {c.desc && <p class="menu-item-desc">{c.desc}</p>}
                  </div>
                ))}
              </div>
            </div>
            <div>
              <h4 class="menu-subcat">{d.dining.menus.drinks.intlCocktailsTitle}</h4>
              <div class="menu-list">
                {d.dining.menus.drinks.intlCocktails.map((c) => (
                  <div class="menu-item">
                    <div class="menu-item-name">{c.name}</div>
                    {c.desc && <p class="menu-item-desc">{c.desc}</p>}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="menu-cols menu-sec-gap">
            <div class="menu-group">
              <h3 class="menu-sec-title">{d.dining.menus.drinks.winesTitle}</h3>
              <ul>
                {d.dining.menus.drinks.wines.map((w) => <li>{w}</li>)}
              </ul>
            </div>
            <div class="menu-group">
              <h3 class="menu-sec-title">{d.dining.menus.drinks.spiritsTitle}</h3>
              <ul>
                {d.dining.menus.drinks.spirits.map((s) => <li>{s}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div class="sheet-foot">
        <button type="button" class="sheet-back" id="dining-modal-back">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          {d.dining.back}
        </button>
      </div>
    </div>
  </div>

  <div class="sheet-modal info-modal" id="info-modal" data-lenis-prevent role="dialog" aria-modal="true" aria-labelledby="info-modal-title" aria-hidden="true" inert>
    <div class="sheet-backdrop" data-close-modal></div>
    <div class="sheet-card">
      <div class="sheet-head">
        <div class="sheet-brand">
          <img src="/images/logo-seal.png" alt="" width="38" height="38" />
          <div>
            <p class="sheet-eyebrow">Aurora Hacienda Zanzibar · Nungwi</p>
            <h2 id="info-modal-title">{d.info.title}</h2>
          </div>
        </div>
        <button type="button" class="sheet-close" data-close-modal aria-label={d.nav.close}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
        </button>
      </div>

      <div class="sheet-body" data-lenis-prevent>
        <p class="info-intro">{d.info.intro}</p>
        {d.info.sections.map((sec, i) => (
          <details class="info-item" open={i === 0}>
            <summary>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={infoIcons[i]}/></svg>
              <span>{sec.title}</span>
              <svg class="info-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <ul>
              {sec.items.map((item) => <li>{item}</li>)}
            </ul>
            {sectionLinks[i] && (
              <div class="info-actions">
                {sectionLinks[i].filter(([, url]) => url).map(([key, url]) => (
                  <a href={url} target="_blank" rel={url.includes('.go.tz') ? 'noopener' : 'noopener sponsored'}>
                    <span>{d.info.links[key]}</span>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
                  </a>
                ))}
              </div>
            )}
          </details>
        ))}
        <h3 class="menu-sec-title">{d.info.sources}</h3>
        <ul class="info-links">
          {sources.map(([key, url]) => (
            <li><a href={url} target="_blank" rel="noopener">{d.info.links[key]}</a></li>
          ))}
        </ul>
        <p class="info-checked">{d.info.disclosure}</p>
        <p class="info-checked">{d.info.checked}</p>
      </div>

      <div class="sheet-foot">
        <button type="button" class="sheet-back" data-close-modal>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          {d.dining.back}
        </button>
      </div>
    </div>
  </div>

  <div class="sheet-modal book-modal" id="book-modal" data-lenis-prevent role="dialog" aria-modal="true" aria-labelledby="book-modal-title" aria-hidden="true" inert>
    <div class="sheet-backdrop" data-close-modal></div>
    <div class="sheet-card">
      <div class="sheet-head">
        <div class="sheet-brand">
          <img src="/images/logo-seal.png" alt="" width="38" height="38" />
          <div>
            <p class="sheet-eyebrow">Aurora Hacienda Zanzibar · Nungwi</p>
            <h2 id="book-modal-title">{d.book.title}</h2>
          </div>
        </div>
        <button type="button" class="sheet-close" data-close-modal aria-label={d.nav.close}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
        </button>
      </div>

      <div class="sheet-body" data-lenis-prevent>
        <div class="direct-contact">
          <a href={contact.whatsappUrl} target="_blank" rel="noopener" title={contact.phoneDisplay}>
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.5 7.5L3 20.5l1.6-5.2A8.5 8.5 0 1 1 21 11.5z"/><path d="M9.5 8.8c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .5-.1.6l-.5.6c-.1.1-.1.3 0 .5a7.2 7.2 0 0 0 2.5 2.5c.2.1.4.1.5 0l.6-.5c.2-.2.4-.2.7-.1l1.6.8c.3.1.4.3.4.5v.5c0 .3-.2.7-.6.9-.6.3-1.4.4-2.5 0a9.5 9.5 0 0 1-5-5c-.4-1.1-.3-1.9 0-2.5z"/></svg>
            <span>{d.book.whatsapp}</span>
          </a>
          <a href={contact.emailHref} title={contact.email}>
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 7l9 6 9-6"/></svg>
            <span>{d.book.emailLabel}</span>
          </a>
        <a class="book-info" href="#info">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8v.01"/></svg>
          <span>{d.book.infoBtn}</span>
        </a>
        </div>

        <form id="book-form" data-guest-language={new Intl.DisplayNames(['en'], { type: 'language' }).of(lang)} data-whatsapp={contact.whatsappUrl} data-email={contact.emailHref} novalidate>
          <label>{d.book.name}<input name="name" autocomplete="name" required /></label>
          <label>{d.book.email}<input name="email" type="email" autocomplete="email" required /></label>
          <div class="row">
            <label>{d.book.arrival}<input name="arrival" type="date" placeholder={d.book.datePlaceholder} required /></label>
            <label>{d.book.departure}<input name="departure" type="date" placeholder={d.book.datePlaceholder} required /></label>
          </div>
          <label>{d.book.guests}<input name="guests" type="number" min="1" max="12" value="2" required /></label>
          <label class="check-row">
            <input type="checkbox" name="transfer" />
            <span>{d.book.transfer}</span>
          </label>
          <label>{d.book.message}<textarea name="message" rows="3"></textarea></label>
          <p class="note">{d.book.rateNote}</p>
        </form>
      </div>

      <div class="sheet-foot book-foot">
        <p class="form-msg" id="form-msg" role="status" hidden>{d.book.validationMsg}</p>
        <div class="book-actions">
          <button type="button" class="sheet-back" data-close-modal>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
            <span>{d.dining.back}</span>
          </button>
          <button class="btn btn--gold" type="submit" form="book-form" data-channel="whatsapp"><span>{d.book.sendWhatsapp}</span></button>
          <button class="btn" type="button" data-channel="email"><span>{d.book.sendEmail}</span></button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const bar = document.getElementById('bar'), bf = document.getElementById('book-form');
    const msgEl = document.getElementById('form-msg');
    bar.addEventListener('submit', (e) => {
      e.preventDefault();
      for (const n of ['arrival', 'departure', 'guests']) {
        const target = bf.elements[n], value = bar.elements[n].value, picker = target._flatpickr;
        if (picker) value ? picker.setDate(value, true) : picker.selectedDates.length && picker.clear();
        else target.value = value;
        const shown = picker?.altInput || target;
        shown.classList.add('prefilled');
        setTimeout(() => shown.classList.remove('prefilled'), 1800);
      }
      window.__openBooking?.();
    });
    const clock = document.getElementById('clock');
    const tick = () => {
      clock.textContent = new Intl.DateTimeFormat(document.documentElement.lang, {
        timeZone: 'Africa/Dar_es_Salaam',
        hour: '2-digit',
        minute: '2-digit',
      }).format(new Date());
    };
    tick();
    setInterval(tick, 20000);

    const buildInquiry = () => {
      const name = bf.elements.name.value.trim();
      const email = bf.elements.email.value.trim();
      const arrival = bf.elements.arrival.value;
      const departure = bf.elements.departure.value;
      const guests = bf.elements.guests.value || '2';
      const transfer = bf.elements.transfer.checked ? 'Yes' : 'No';
      const message = bf.elements.message.value.trim();
      const lines = [
        'Aurora Hacienda Zanzibar — Booking & Rate Inquiry',
        'Guest language: ' + bf.dataset.guestLanguage,
        'Name: ' + name,
        email ? 'Email: ' + email : null,
        arrival ? 'Arrival: ' + arrival : null,
        departure ? 'Departure: ' + departure : null,
        'Guests: ' + guests,
        'Airport transfer: ' + transfer,
        message ? 'Notes: ' + message : null,
      ].filter(Boolean);
      return lines.join('\n');
    };

    const dispatchInquiry = (channel) => {
      const nameEl = bf.elements.name;
      if (!nameEl.value.trim()) {
        msgEl.hidden = false;
        nameEl.focus();
        return;
      }
      msgEl.hidden = true;
      const body = buildInquiry();
      if (channel === 'email') {
        const subject = encodeURIComponent('Booking Inquiry — Aurora Hacienda Zanzibar');
        window.location.href = bf.dataset.email + '?subject=' + subject + '&body=' + encodeURIComponent(body);
      } else {
        window.open(bf.dataset.whatsapp + '?text=' + encodeURIComponent(body), '_blank', 'noopener');
      }
    };

    bf.addEventListener('submit', (e) => {
      e.preventDefault();
      dispatchInquiry('whatsapp');
    });
    document.querySelector('#book-modal button[data-channel="email"]')?.addEventListener('click', () => {
      dispatchInquiry('email');
    });

    document.querySelectorAll('a[data-request-transfer]').forEach((el) => {
      el.addEventListener('click', () => {
        const cb = bf.elements.transfer;
        if (!cb) return;
        cb.checked = true;
        const row = cb.closest('.check-row');
        if (row) {
          row.classList.add('prefilled');
          setTimeout(() => row.classList.remove('prefilled'), 1800);
        }
      });
    });
  </script>
</Base>
