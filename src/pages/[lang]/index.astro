---
import Base from '../../layouts/Base.astro';
import { available, t, isTbc, type Locale } from '../../i18n';
import { mapUrl } from '../../i18n/site';

export function getStaticPaths() {
  return available.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const d = t(lang);
---
<Base lang={lang}>
  <main>
    <section class="panel hero" id="top-panel" data-dot={d.nav.home}>
      <img src="/images/hero.jpg" alt="" class="panel-img zoom" fetchpriority="high" />
      <div class="shade"></div>
      <div class="panel-text reveal">
        <p class="eyebrow">{d.hero.eyebrow}</p>
        <h1>{d.hero.title}</h1>
        <p class="lead">{d.hero.text}</p>
      </div>
      <div class="dock">
        <nav class="quick" aria-label={d.nav.quick}>
          <a href="#rooms"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18V7M3 14h18v4M21 14v-2.5A2.5 2.5 0 0 0 18.5 9H11v5M6.5 11.5a1.5 1.5 0 1 0 0-.01"/></svg>{d.nav.stay}</a>
          <a href="#house"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V10.5L12 4l8 6.5V21M4 21h16M9.5 21v-5.5a2.5 2.5 0 0 1 5 0V21"/></svg>{d.nav.house}</a>
          <a href="#nungwi"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>{d.nav.place}</a>
          <a href="#book"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="1"/><path d="M4 10h16M8 3v4M16 3v4"/></svg>{d.nav.book}</a>
        </nav>
        <form class="bar" id="bar" novalidate>
          <label>{d.book.arrival}<input type="date" name="arrival" /></label>
          <label>{d.book.departure}<input type="date" name="departure" /></label>
          <label>{d.book.guests}<input type="number" name="guests" min="1" max="12" value="2" /></label>
          <button type="submit">{d.hero.check}</button>
        </form>
        <p class="clock"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{d.hero.time} <time id="clock"></time></p>
      </div>
    </section>

    <section class="panel" id="welcome" data-dot={d.welcome.eyebrow}>
      <img src="/images/welcome.jpg" alt="" class="panel-img" loading="lazy" />
      <div class="shade"></div>
      <div class="panel-text reveal">
        <p class="eyebrow">{d.welcome.eyebrow}</p>
        <h2>{d.welcome.title}</h2>
        <p>{d.welcome.p1}</p>
        <p>{d.welcome.p2}</p>
      </div>
    </section>

    <div id="rooms" data-dot={d.rooms.eyebrow}>
      {d.rooms.items.map((r, i) => (
        <section class="panel" id={`room-${i + 1}`}>
          <img src={`/images/room-${i + 1}.jpg`} alt="" class="panel-img" loading="lazy" />
          <div class="shade"></div>
          <div class="panel-text reveal">
            <p class="eyebrow">{d.rooms.eyebrow} · {i + 1} / {d.rooms.items.length}</p>
            <h2>{r.name}</h2>
            <p>{isTbc(r.text) ? r.text.tbc : r.text}{isTbc(r.text) && <span class="tbc">{d.tbcLabel}</span>}</p>
            <p class="price"><span>{d.rooms.price}</span> {d.rooms.priceTbc.tbc}<span class="tbc">{d.tbcLabel}</span></p>
            <a class="btn" href="#book">{d.nav.book}</a>
          </div>
        </section>
      ))}
    </div>

    <section class="panel" id="house" data-dot={d.house.eyebrow}>
      <img src="/images/house.jpg" alt="" class="panel-img" loading="lazy" />
      <div class="shade"></div>
      <div class="panel-text reveal">
        <p class="eyebrow">{d.house.eyebrow}</p>
        <h2>{d.house.title}</h2>
        <p>{d.house.text}</p>
        <p class="note">{d.house.more.tbc}<span class="tbc">{d.tbcLabel}</span></p>
      </div>
    </section>

    <section class="panel" id="nungwi" data-dot={d.place.eyebrow}>
      <img src="/images/nungwi.jpg" alt="" class="panel-img" loading="lazy" />
      <div class="shade"></div>
      <div class="panel-text reveal">
        <p class="eyebrow">{d.place.eyebrow}</p>
        <h2>{d.place.title}</h2>
        <p>{d.place.text}</p>
        <p class="note">{d.place.more.tbc}<span class="tbc">{d.tbcLabel}</span></p>
        <a class="btn" href={mapUrl} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
          {d.place.map}
        </a>
      </div>
    </section>

    <section class="book" id="book" data-dot={d.book.eyebrow}>
      <div class="book-inner reveal">
        <p class="eyebrow">{d.book.eyebrow}</p>
        <h2>{d.book.title}</h2>
        <p class="lead">{d.book.text}</p>
        <form id="book-form" novalidate>
          <label>{d.book.name}<input name="name" autocomplete="name" required /></label>
          <label>{d.book.email}<input name="email" type="email" autocomplete="email" required /></label>
          <div class="row">
            <label>{d.book.arrival}<input name="arrival" type="date" required /></label>
            <label>{d.book.departure}<input name="departure" type="date" required /></label>
          </div>
          <label>{d.book.guests}<input name="guests" type="number" min="1" max="12" value="2" required /></label>
          <label>{d.book.message}<textarea name="message" rows="3"></textarea></label>
          <button class="btn" type="submit">{d.book.send}</button>
          <p class="note">{d.book.note.tbc}<span class="tbc">{d.tbcLabel}</span></p>
          <p class="form-msg" id="form-msg" role="status" hidden>{d.book.unavailable}</p>
        </form>
      </div>
    </section>
  </main>

  <script is:inline>
    const bar = document.getElementById('bar'), bf = document.getElementById('book-form');
    bar.addEventListener('submit', (e) => {
      e.preventDefault();
      for (const n of ['arrival', 'departure', 'guests']) bf.elements[n].value = bar.elements[n].value;
      window.__lenis ? window.__lenis.scrollTo('#book', { duration: 1.6 }) : document.getElementById('book').scrollIntoView({ behavior: 'smooth' });
    });
    const clock = document.getElementById('clock');
    const tick = () => { clock.textContent = new Intl.DateTimeFormat(document.documentElement.lang, { timeZone: 'Africa/Dar_es_Salaam', hour: '2-digit', minute: '2-digit' }).format(new Date()); };
    tick(); setInterval(tick, 20000);
    document.getElementById('book-form').addEventListener('submit', (e) => {
      e.preventDefault();
      document.getElementById('form-msg').hidden = false;
    });
  </script>
</Base>
